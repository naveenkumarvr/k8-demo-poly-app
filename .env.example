# Poly-Shop Local Development Environment Template
# Copy this file to .env and adjust values for your environment.
# In production, load secrets via Kubernetes Secrets / Vault instead.

# PostgreSQL (Product Service)
POSTGRES_DB=products
POSTGRES_USER=productuser
POSTGRES_PASSWORD=productpass

# Product Service
PRODUCT_SERVICE_DATABASE_URL=postgres://productuser:productpass@postgres:5432/products?sslmode=disable

# Redis (Cart Service) - no auth by default
REDIS_ADDR=redis:6379

# Jaeger / OpenTelemetry
# Go gRPC services use host:port (no scheme); Java agent requires full http:// URL + grpc protocol.
OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
OTEL_EXPORTER_OTLP_ENDPOINT_JAVA=http://jaeger:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT_HTTP=http://jaeger:4318
# Jaeger only supports OTLP traces, so disable metrics/logs export for the Java agent.
OTEL_METRICS_EXPORTER=none
OTEL_LOGS_EXPORTER=none

# Checkout Service
CART_SERVICE_URL=http://cart-service:8080
SPRING_PROFILES_ACTIVE=prod
STARTUP_DELAY_SECONDS=15
DB_URL=jdbc:h2:mem:checkoutdb
DB_DRIVER=org.h2.Driver
DB_USER=sa
DB_PASSWORD=
DB_DDL_AUTO=create-drop
H2_CONSOLE_ENABLED=true

# Notification Worker (async background processor)
EVENT_CHANNEL=cart-events
