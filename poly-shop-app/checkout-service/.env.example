# Checkout Service Environment Configuration
# Copy this file to .env for local development.
# In production, load secrets via Kubernetes Secrets or Vault.

# Service Configuration
SERVICE_NAME=checkout-service
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
PORT=8085

# Spring Boot Profile (set to 'prod' for production)
SPRING_PROFILES_ACTIVE=development

# Database Configuration (H2 local/demo only; use PostgreSQL in production)
DB_URL=jdbc:h2:mem:checkoutdb
DB_DRIVER=org.h2.Driver
DB_USER=sa
DB_PASSWORD=
DB_DIALECT=org.hibernate.dialect.H2Dialect
DB_DDL_AUTO=create-drop
H2_CONSOLE_ENABLED=true

# Upstream Service URLs
CART_SERVICE_URL=http://cart-service:8080

# OpenTelemetry Configuration
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=checkout-service
OTEL_RESOURCE_ATTRIBUTES=service.namespace=poly-shop,service.version=1.0.0

# Startup delay for Kubernetes startupProbe testing
STARTUP_DELAY_SECONDS=15

# JVM Options
JAVA_OPTS=-Xms512m -Xmx768m
